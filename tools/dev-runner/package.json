    "check:gateway-live": "node --import tsx src/gateway-live.ts",
    "accept": "node --import tsx src/accept.ts"
  },
  "dependencies": {
    "@sdlc/api": "workspace:^",
    "@sdlc/core": "workspace:^",
    "@sdlc/db": "workspace:^",
    "@sdlc/dev-db": "workspace:^",
    "@sdlc/dev-idp": "workspace:^",
    "@sdlc/gateway": "workspace:^",
    "@sdlc/schemas": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  }
}
