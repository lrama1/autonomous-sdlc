{
  "name": "@sdlc/dev-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/main.ts --demo",
